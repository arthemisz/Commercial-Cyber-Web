datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CLIENT
  CONSULTANT
  PLATFORM_ADMIN
}

enum EngagementStatus {
  DRAFT_SCOPE
  ROE_PENDING_SIGNATURES
  ROE_SIGNED
  FUNDS_IN_ESCROW
  TESTING_ACTIVE
  ABORTED_KILL_SWITCH
  REPORT_DELIVERED
  COMPLETED
}

enum SeverityLevel {
  INFORMATIONAL
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VulnStatus {
  REPORTED
  ACKNOWLEDGED
  FIX_COMMITTED
  RETEST_VERIFIED
  CLOSED
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  role               UserRole            @default(CLIENT)
  mfaEnabled         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  consultantProfile  ConsultantProfile?
  clientEngagements  Engagement[]        @relation("ClientEngagements")
  auditLogs          AuditLog[]
}

model ConsultantProfile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  bio                String?
  certifications     String[]
  hourlyRateCents    Int?
  stripeAccountId    String?             @unique
  payoutsEnabled     Boolean             @default(false)
  createdAt          DateTime            @default(now())

  engagements        Engagement[]        @relation("ConsultantEngagements")
}

model Engagement {
  id                    String              @id @default(uuid())
  title                 String
  clientId              String
  consultantId          String
  status                EngagementStatus    @default(DRAFT_SCOPE)
  scopeTargetJSON       Json
  roeDocumentHash       String?
  roeClientSignedAt     DateTime?
  roeConsultantSignedAt DateTime?
  testingStartsAt       DateTime?
  testingEndsAt         DateTime?
  stripePaymentIntentId String?             @unique
  totalEscrowAmount     Int
  killSwitchTriggeredAt DateTime?
  killSwitchReason      String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  client                User                @relation("ClientEngagements", fields: [clientId], references: [id])
  consultant            ConsultantProfile   @relation("ConsultantEngagements", fields: [consultantId], references: [id])
  milestones            Milestone[]
  findings              Finding[]
  artifacts             Artifact[]
}

model Milestone {
  id             String          @id @default(uuid())
  engagementId   String
  engagement     Engagement      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  title          String
  amountCents    Int
  isApproved     Boolean         @default(false)
  paidOutAt      DateTime?
}

model Finding {
  id             String          @id @default(uuid())
  engagementId   String
  engagement     Engagement      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  title          String
  cweIdentifier  String?
  cvssVector     String
  cvssScore      Float
  severity       SeverityLevel
  description    String
  proofOfConcept String
  remediation    String
  status         VulnStatus      @default(REPORTED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Artifact {
  id             String          @id @default(uuid())
  engagementId   String
  engagement     Engagement      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  storagePath    String
  fileName       String
  fileSize       Int
  mimeType       String
  sha256Checksum String
  ttlExpiresAt   DateTime
  createdAt      DateTime        @default(now())
}

model AuditLog {
  id             String          @id @default(uuid())
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  resourceType   String
  resourceId     String
  metadata       Json?
  ipAddress      String
  timestamp      DateTime        @default(now())
}
